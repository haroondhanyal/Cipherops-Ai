DATABASE_URL=postgresql+psycopg://cipherops:replace-with-postgres-password@localhost:5432/cipherops
JWT_SECRET=replace-with-a-long-random-secret-before-running
JWT_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
ALLOW_PUBLIC_SIGNUP=false
PASSWORD_RESET_DEV_MODE=false
# Optional SMTP configuration for password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
# Optional manual reputation lookups. Keep this key on the API server only.
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_TIMEOUT_SECONDS=8
